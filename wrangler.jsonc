{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "encrypted-group-chat",
	"main": "src/worker.js",
	"compatibility_date": "2025-09-01",
	"keep_vars": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoomDO"
			},
			{
				"name": "LOGIN_GUARD",
				"class_name": "LoginGuardDO"
			}
		]
	},
	"exports": {
		"ChatRoomDO": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"LoginGuardDO": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"observability": {
		"enabled": true
	}
}
